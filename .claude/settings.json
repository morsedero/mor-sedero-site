{
  "permissions": {
    "allow": [
      "Bash(netlify status *)",
      "PowerShell(netlify status 2>&1)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -iE '(error|failed|fatal|warning|built|wrote|✓|^npm)' | head -30 || echo '✓ Completed successfully'",
            "if": "Bash(node tools/build-standalone* || npm install* || npm ci* || netlify build* || netlify deploy*)"
          }
        ]
      }
    ]
  }
}
