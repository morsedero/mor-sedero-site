rules_version = '2';
// Daisey v1. Each signed-in user can read and write only their own subtree,
// users/{uid}/**. Everything else is denied.
// Not deployed from here: paste into Firebase console → Firestore → Rules →
// Publish. This file is the record of what's live.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
